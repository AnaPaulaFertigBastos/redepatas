erDiagram
    direction LR

    UF {
        char2 sigla PK
        varchar nome
    }
    MUNICIPIO {
        char7 codigo_ibge PK
        char2 uf_sigla FK
        varchar nome
    }
    USUARIO {
        uuid id PK
        varchar nome
        varchar email UK
        varchar senha_hash
        varchar status
        timestamptz criado_em
    }
    TOKEN_RENOVACAO {
        uuid id PK
        uuid usuario_id FK
        varchar token_hash UK
        timestamptz expira_em
        timestamptz revogado_em
    }
    PONTO_APOIO {
        uuid id PK
        char7 municipio_codigo_ibge FK
        uuid criado_por_usuario_id FK
        varchar nome
        text descricao
        decimal latitude
        decimal longitude
        varchar referencia_endereco
        varchar frequencia_abastecimento
        int quantidade_animais_estimada
        varchar situacao_geral
        timestamptz criado_em
        timestamptz atualizado_em
    }
    RECURSO {
        varchar codigo PK
        varchar nome
    }
    PONTO_RECURSO {
        uuid ponto_id PK, FK
        varchar recurso_codigo PK, FK
        varchar situacao
        timestamptz verificado_em
    }
    MANUTENCAO {
        uuid id PK
        uuid ponto_id FK
        uuid usuario_id FK
        varchar recurso_codigo FK
        varchar acao
        text observacao
        timestamptz ocorrido_em
    }
    ANIMAL {
        uuid id PK
        uuid cadastrado_por_usuario_id FK
        varchar identificacao
        text descricao
        varchar situacao
        timestamptz criado_em
    }
    AVISTAMENTO {
        uuid id PK
        uuid animal_id FK
        uuid usuario_id FK
        char7 municipio_codigo_ibge FK
        decimal latitude
        decimal longitude
        text observacao
        timestamptz visto_em
    }
    FOTO {
        uuid id PK
        uuid ponto_id FK
        uuid avistamento_id FK
        uuid manutencao_id FK
        uuid enviado_por_usuario_id FK
        varchar url_arquivo
        timestamptz criada_em
    }
    PONTO_SEGUIDO {
        uuid usuario_id PK, FK
        uuid ponto_id PK, FK
        timestamptz criado_em
    }
    PREFERENCIA_ALERTA {
        uuid usuario_id PK, FK
        bool habilitado
        int raio_metros
        bool avisar_agua
        bool avisar_racao
        bool avisar_manutencao
    }
    DISPOSITIVO {
        uuid id PK
        uuid usuario_id FK
        varchar token_push UK
        varchar plataforma
        timestamptz atualizado_em
    }
    NOTIFICACAO {
        uuid id PK
        uuid usuario_id FK
        uuid ponto_id FK
        varchar tipo
        varchar chave_deduplicacao UK
        timestamptz enviada_em
        timestamptz lida_em
    }

    UF ||--o{ MUNICIPIO : contem
    MUNICIPIO |o--o{ PONTO_APOIO : classifica
    MUNICIPIO |o--o{ AVISTAMENTO : classifica
    USUARIO ||--o{ PONTO_APOIO : cadastra
    USUARIO ||--o{ TOKEN_RENOVACAO : possui
    PONTO_APOIO ||--o{ PONTO_RECURSO : oferece
    RECURSO ||--o{ PONTO_RECURSO : configura
    PONTO_APOIO ||--o{ MANUTENCAO : recebe
    USUARIO ||--o{ MANUTENCAO : registra
    RECURSO |o--o{ MANUTENCAO : relacionado
    USUARIO ||--o{ ANIMAL : cadastra
    ANIMAL |o--o{ AVISTAMENTO : identificado
    USUARIO ||--o{ AVISTAMENTO : registra
    PONTO_APOIO |o--o{ FOTO : retratado
    AVISTAMENTO |o--o{ FOTO : retratado
    MANUTENCAO |o--o{ FOTO : documentada
    USUARIO ||--o{ FOTO : envia
    USUARIO ||--o{ PONTO_SEGUIDO : acompanha
    PONTO_APOIO ||--o{ PONTO_SEGUIDO : acompanhado
    USUARIO ||--o| PREFERENCIA_ALERTA : configura
    USUARIO ||--o{ DISPOSITIVO : usa
    USUARIO ||--o{ NOTIFICACAO : recebe
    PONTO_APOIO |o--o{ NOTIFICACAO : motiva
